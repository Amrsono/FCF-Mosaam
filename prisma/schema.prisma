generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id              String       @id @default(uuid())
  phone           String       @unique
  name            String
  email           String?
  address         String?
  tier            String       @default("New")
  deliveries      Int          @default(0) // Jumia deliveries
  bostaDeliveries Int          @default(0) // Bosta deliveries
  gender          String       @default("Unknown")
  createdAt       DateTime     @default(now())

  orders          Order[]
  bostaOrders     BostaOrder[]
}

model Order {
  id            String    @id
  customerPhone String
  description   String
  totalValue    Float     // Using Float for typical DB precision without needing Decimal.js locally 
  category      String
  subcategory   String?
  status             String    @default("Inventory") // "Inventory", "Picked_Up", "Returned", "Cancelled"
  receivedAt         DateTime  @default(now())
  pickedUpAt         DateTime?
  returnedAt         DateTime?

  // New fields for detailed inventory reporting
  outlet             String    @default("eltalg")
  size               String    @default("M")
  paymentMethod      String    @default("Cash")
  orderCost          Float     @default(0)

  // Discounts
  discountCode       String?
  discountAmount     Float     @default(0)

  // Cancellation and Deletion tracking
  cancellationReason String?
  isDeleted          Boolean   @default(false)
  deletionReason     String?

  customer      Customer  @relation(fields: [customerPhone], references: [phone])
}

model BasataTransaction {
  id              String   @id @default(uuid())
  category        String   // "Mobile", "Internet", "Utilities", "Government", "Other"
  serviceProvider String   // e.g. "Vodafone Top-up", "WE ADSL", "Electricity NFC"
  amount          Float
  transactionId   String?  // The POS Transaction ID
  paymentMethod   String   @default("Cash") // Cash, Card, etc.
  percentage      Float    @default(0) // Commission or Fee percentage
  referenceNumber String?  // Keep for backward compatibility or legacy
  outlet          String   @default("eltalg")
  performedAt     DateTime @default(now())
}

model BostaOrder {
  id            String    @id
  customerPhone String
  description   String
  totalValue    Float     
  category      String
  subcategory   String?
  status             String    @default("Inventory") // "Inventory", "Picked Up", "Returned", "Cancelled"
  receivedAt         DateTime  @default(now())
  pickedUpAt         DateTime?
  returnedAt         DateTime?

  // New fields for detailed inventory reporting
  outlet             String    @default("eltalg")
  size               String    @default("M")
  paymentMethod      String    @default("Cash")
  orderCost          Float     @default(0)

  // Discounts
  discountCode       String?
  discountAmount     Float     @default(0)

  // Cancellation and Deletion tracking
  cancellationReason String?
  isDeleted          Boolean   @default(false)
  deletionReason     String?

  customer           Customer  @relation(fields: [customerPhone], references: [phone])
}

model DiscountCode {
  id              String   @id @default(uuid())
  code            String   @unique
  type            String   // "FIXED" | "PERCENT"
  value           Float
  minSpend        Float    @default(0)
  maxUses         Int?     // null means unlimited
  usedCount       Int      @default(0)
  isFirstTimeOnly    Boolean  @default(false)
  maxUsesPerCustomer Int?     @default(1)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
}

model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         String   @default("staff") // "admin" | "staff"
  outlet       String   @default("eltalg")
  createdAt    DateTime @default(now())
}

model UserLog {
  id        String   @id @default(uuid())
  username  String
  action    String
  details   String?
  createdAt DateTime @default(now())
}

model CustomerReturn {
  id            String    @id @default(uuid())
  orderId       String?   // Optional link to the original Jumia order
  customerPhone String
  customerName  String    @default("Unknown")
  description   String
  reason        String?
  outlet        String    @default("eltalg") // Which branch received the return
  status        String    @default("At Station") // "At Station" | "Returned to Jumia"
  receivedAt    DateTime  @default(now())
  returnedAt    DateTime? // When marked as returned to Jumia
}

model CallLog {
  id            String    @id @default(uuid())
  orderId       String                          // The Jumia or Bosta order ID
  orderSource   String    @default("jumia")     // "jumia" | "bosta"
  customerPhone String
  agentName     String?                         // Username who took ownership
  outlet        String    @default("eltalg")    // Outlet associated with the order/agent
  takenAt       DateTime?                       // When agent clicked "Take Call"
  resolution    String?                         // "coming_pickup" | "will_cancel" | "no_answer" | "declined" | "no_longer_wants"
  notes         String?
  resolvedAt    DateTime?
  isClosed      Boolean   @default(false)
  createdAt     DateTime  @default(now())
}

model ImtidadOrder {
  id              String   @id // e.g. IMT-20260530-XXXX
  senderName      String
  senderPhone     String
  senderCity      String
  dropoffOutlet   String   // e.g. "cairo_hub", "eltalg", etc.
  recipientName   String
  recipientPhone  String
  recipientCity   String
  pickupOutlet    String   // e.g. "alex_hub", "mostashfa", etc.
  description     String
  weight          Float    @default(1.0)
  size            String   @default("M") // S, M, L
  totalValue      Float    @default(0.0)
  shippingCost    Float    @default(0.0)
  status          String   @default("Pending Drop-off") // Pending Drop-off | At Drop-off Station | In Transit | Ready for Pickup | Picked Up | Cancelled
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ImtidadOutlet {
  id        String   @id @default(uuid())
  key       String   @unique // e.g. "eltalg", "tegara", "cairo_hub"
  nameEn    String
  nameAr    String
  city      String
  x         Int      @default(200) // SVG layout coordinate X
  y         Int      @default(200) // SVG layout coordinate Y
  baseLoad  Int      @default(50)  // Base package load percentage for heatmap
  status    String   @default("Active") // "Active" | "Inactive"
  createdAt DateTime @default(now())
}



